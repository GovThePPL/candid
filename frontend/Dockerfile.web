# Stage 1 — Generate JavaScript API client from OpenAPI spec
FROM openapitools/openapi-generator-cli:v7.12.0 AS api-gen
COPY docs/api.yaml /api.yaml
RUN docker-entrypoint.sh generate -i /api.yaml -g javascript -o /api

# Stage 2 — Build Expo web bundle
FROM node:22-alpine AS builder
WORKDIR /build

# Copy generated API client and apply patches from regenerate_api.sh
COPY --from=api-gen /api ./api

# Patch CardItem models: fix oneOf discriminator validation
RUN for pair in \
      "PositionCardItem.js:position" \
      "SurveyCardItem.js:survey" \
      "ChatRequestCardItem.js:chat_request" \
      "KudosCardItem.js:kudos" \
      "DemographicCardItem.js:demographic" \
      "PairwiseCardItem.js:pairwise" \
      "BridgingKudosCardItem.js:bridging_kudos"; do \
      FILE="api/src/model/${pair%%:*}"; \
      TYPE="${pair##*:}"; \
      if [ -f "$FILE" ]; then \
        sed -i "s#// ensure the json data is a string#// ensure the json data matches the expected enum value#" "$FILE"; \
        sed -i "s#if (data\['type'\] \&\& !(typeof data\['type'\] === 'string' || data\['type'\] instanceof String)) {#if (data['type'] !== '$TYPE') {#" "$FILE"; \
        sed -i "s#throw new Error(\"Expected the field \`type\` to be a primitive type in the JSON string but got \" + data\['type'\]);#throw new Error(\"Expected type to be '$TYPE' but got '\" + data['type'] + \"'\");#" "$FILE"; \
      fi; \
    done

# Patch ApiClient.js: remove User-Agent header (browsers forbid setting it)
RUN sed -i "s|'User-Agent': 'OpenAPI-Generator/0.1.0/Javascript'||" api/src/ApiClient.js

# Build API client
WORKDIR /build/api
RUN npm install && npm run build

# Copy app source and install dependencies
WORKDIR /build/app
COPY frontend/app/package.json frontend/app/package-lock.json frontend/app/.npmrc ./
RUN npm ci

# Copy remaining app source
COPY frontend/app/ ./

# Build custom editor WebView HTML
RUN cd lib/customEditor && npx vite build && node buildEditorHtml.js

# Accept build-time env vars (baked into Metro bundle)
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_CHAT_URL
ARG EXPO_PUBLIC_KEYCLOAK_URL
ARG EXPO_PUBLIC_SMS_ENABLED
ARG EXPO_PUBLIC_EMAIL_REQUIRED
ARG EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB
ARG EXPO_PUBLIC_APPLE_SERVICE_ID
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL \
    EXPO_PUBLIC_CHAT_URL=$EXPO_PUBLIC_CHAT_URL \
    EXPO_PUBLIC_KEYCLOAK_URL=$EXPO_PUBLIC_KEYCLOAK_URL \
    EXPO_PUBLIC_SMS_ENABLED=$EXPO_PUBLIC_SMS_ENABLED \
    EXPO_PUBLIC_EMAIL_REQUIRED=$EXPO_PUBLIC_EMAIL_REQUIRED \
    EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=$EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB \
    EXPO_PUBLIC_APPLE_SERVICE_ID=$EXPO_PUBLIC_APPLE_SERVICE_ID

# Build web bundle
RUN npx expo export --platform web

# Stage 3 — Serve with nginx
FROM nginx:1.27-alpine
COPY --from=builder /build/app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
