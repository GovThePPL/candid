# Environment variables for Candid
# Copy to .env and fill in real values for production.
# Docker Compose automatically loads .env.

# --- Required for production (FLASK_ENV=production) ---
FLASK_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://user:CHANGE_ME@db:5432/candid

# Keycloak OIDC
KEYCLOAK_URL=https://your-keycloak-domain
KEYCLOAK_REALM=candid
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME

# Polis admin credentials
POLIS_ADMIN_CLIENT_SECRET=CHANGE_ME
POLIS_ADMIN_PASSWORD=CHANGE_ME

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://your-frontend-domain

# Social login (Apple / Google)
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
APPLE_SERVICE_ID=com.candid.app

# Frontend social login (Expo env vars — set these before running frontend/start.sh)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_APPLE_SERVICE_ID=com.candid.app.web

# SMS Phone Verification (Twilio)
SMS_VERIFICATION_ENABLED=true
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# JWT signing key for pending social login tokens
SECRET_KEY=CHANGE_ME

# --- Optional ---

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379

# NLP / AI service
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Polis
POLIS_API_URL=http://polis-server:5000/api/v3
POLIS_PUBLIC_URL=https://your-polis-domain
